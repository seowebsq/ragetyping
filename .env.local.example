# Required — the burn engine
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# Absolute site URL, used for OG image URLs on shared receipts
NEXT_PUBLIC_SITE_URL=https://ragetyping.com

# Rate limiting (also settable as vars in wrangler.jsonc)
BURN_LIMIT=12
BURN_LIMIT_PASS=60
BURN_WINDOW_MS=60000

# Rage Pass. Leave unset to keep framing and the higher burn limit switched off.
# RAGE_PASS_SECRET is what signs the pass cookie: any long random string.
RAGE_PASS_SECRET=
STRIPE_SECRET_KEY=
# Stripe Payment Link, with its success URL set to
# https://your-domain/pass/activate?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_RAGE_PASS_URL=

# Tip jar link in the footer — hidden when unset
NEXT_PUBLIC_TIP_URL=
